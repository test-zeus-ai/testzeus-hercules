    {
      "index": 5,
      "action": "Create a pet",
      "status": "passed",
      "kind": "api",
      "actions": [],
      "checks": [],
      "api": {
        "method": "POST",
        "path": "/pets",
        "headers": {
          "X-API-Key": "{{api_key}}"
        },
        "query": {
          "dry": "no",
          "tags": [
            "a",
            "b"
          ]
        },
        "body": {
          "name": "Bella {{run_id}}",
          "owner": "{{email}}",
          "age": 2,
          "vaccinated": true,
          "notes": null
        },
        "auth": {
          "type": "bearer",
          "value": "{{token}}"
        },
        "expect": {
          "status": 201,
          "json_path": [
            {
              "path": "$.name",
              "op": "contains",
              "value": "Bella"
            },
            {
              "path": "$.id",
              "op": "gt",
              "value": 0
            },
            {
              "path": "$.items[*].price",
              "op": "all_gte",
              "value": 0
            },
            {
              "path": "$.missing",
              "op": "not_exists"
            }
          ],
          "headers": [
            {
              "name": "Location",
              "op": "exists"
            }
          ],
          "body_contains": [
            "Bella"
          ],
          "max_time_ms": 2000,
          "json_schema": "spec.yaml#/components/schemas/Pet"
        },
        "save": [
          {
            "name": "pet_id",
            "json_path": "$.id"
          },
          {
            "name": "where",
            "header": "Location"
          }
        ]
