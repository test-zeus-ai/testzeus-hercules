# Keep the build context small: the image needs pyproject.toml, uv.lock, the package,
# the UI sources and the files under docker/.
.git
.github
.gitignore
**/.DS_Store

# Python environments, caches and build output
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
build
dist
.pytest_cache
.mypy_cache
.ruff_cache
.hypothesis
.cache
.coverage
.coverage.*
coverage.xml
htmlcov
**/test_output.xml

# Node: dependencies are installed in the image; the UI bundle is built there too
**/node_modules
ui/dist
testzeus_hercules/ui/static

# Hercules state: projects, runs, evidence, scans, history
**/.hercules
**/run_data
**/*.db
**/installation_id*

# Secrets and local settings
**/.env
**/*.env

# Not part of the image
tests
bench
docs
*.log
Dockerfile
.dockerignore
compose.yaml
