{
  "id": "saucedemo-full-purchase",
  "title": "Standard user completes a purchase",
  "tags": [
    "app:saucedemo",
    "form",
    "secret"
  ],
  "test_data": {
    "username": "standard_user",
    "password": {
      "secret": "SAUCE_PASSWORD"
    },
    "first_name": "Ada",
    "last_name": "Lovelace",
    "zip": "10001"
  },
  "steps": [
    {
      "action": "I open \"/\""
    },
    {
      "action": "I fill \"{{username}}\" in \"Username\""
    },
    {
      "action": "I fill \"{{password}}\" in \"Password\""
    },
    {
      "action": "I click the \"Login\" button",
      "expected": "I should see \"Products\""
    },
    {
      "action": "I open \"/inventory-item.html?id=4\""
    },
    {
      "action": "I click the \"Add to cart\" button"
    },
    {
      "action": "verify",
      "expected": "the \"Cart, 1 items\" button should be visible"
    },
    {
      "action": "I open \"/cart.html\"",
      "expected": "I should see \"Sauce Labs Backpack\""
    },
    {
      "action": "I click the \"Checkout\" button",
      "expected": "I should see \"Checkout: Your Information\""
    },
    {
      "action": "I fill \"{{first_name}}\" in \"First Name\""
    },
    {
      "action": "I fill \"{{last_name}}\" in \"Last Name\""
    },
    {
      "action": "I fill \"{{zip}}\" in \"Zip/Postal Code\""
    },
    {
      "action": "I click the \"Continue\" button",
      "expected": "I should see \"Total: $32.39\""
    },
    {
      "action": "I click the \"Finish\" button",
      "expected": "I should see \"Thank you for your order!\""
    },
    {
      "action": "I click the \"Back Home\" button",
      "expected": "the url should contain \"/inventory.html\""
    }
  ],
  "environment": {
    "base_url": "https://www.saucedemo.com"
  }
}
