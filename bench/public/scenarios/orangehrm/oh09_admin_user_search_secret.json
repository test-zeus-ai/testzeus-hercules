{
  "id": "orangehrm-admin-user-search",
  "title": "Admin finds the Admin system user",
  "tags": [
    "app:orangehrm",
    "search",
    "table",
    "secret"
  ],
  "test_data": {
    "username": "Admin",
    "password": {
      "secret": "ORANGEHRM_PASSWORD"
    }
  },
  "steps": [
    {
      "action": "I open \"/web/index.php/auth/login\""
    },
    {
      "action": "I fill \"{{username}}\" in \"Username\""
    },
    {
      "action": "I fill \"{{password}}\" in \"Password\""
    },
    {
      "action": "I click the \"Login\" button",
      "expected": "I should see \"Dashboard\""
    },
    {
      "action": "I open \"/web/index.php/admin/viewSystemUsers\"",
      "expected": "I should see \"System Users\""
    },
    {
      "action": "I fill \"{{username}}\" in \"Username\""
    },
    {
      "action": "I click the \"Search\" button",
      "expected": "I should see \"(1) Record Found\""
    },
    {
      "action": "verify",
      "expected": "I should see \"Enabled\""
    }
  ],
  "environment": {
    "base_url": "https://opensource-demo.orangehrmlive.com"
  }
}
