{
  "id": "parabank-transfer-funds",
  "title": "Customer transfers funds",
  "tags": [
    "app:parabank",
    "form",
    "arithmetic",
    "secret"
  ],
  "test_data": {
    "username": "john",
    "password": {
      "secret": "PARABANK_PASSWORD"
    },
    "amount": "10"
  },
  "steps": [
    {
      "action": "I open \"/parabank/index.htm\""
    },
    {
      "action": "I fill \"{{username}}\" in \"Username\""
    },
    {
      "action": "I fill \"{{password}}\" in \"Password\""
    },
    {
      "action": "I click the \"Log In\" button",
      "expected": "I should see \"Accounts Overview\""
    },
    {
      "action": "I click the \"Transfer Funds\" link",
      "expected": "I should see \"From account #\""
    },
    {
      "action": "I fill \"{{amount}}\" in \"Amount\""
    },
    {
      "action": "I click the \"Transfer\" button",
      "expected": "I should see \"Transfer Complete!\""
    },
    {
      "action": "verify",
      "expected": "I should see \"$10.00 has been transferred\""
    }
  ],
  "environment": {
    "base_url": "https://parabank.parasoft.com/parabank/"
  }
}
